    {
      "id": "assert:catalog_scope",
      "status": "PROVEN",
      "claim": "The checksum-pinned universal PS4 member catalog contains 337 package families in the ordinary base-package namespace and is the current remote corpus for activity-root discovery.",
      "source_ids": ["source:universal_catalog"]
    },
    {
      "id": "assert:exact_activity_inventory",
      "status": "PROVEN",
      "claim": "Scanning the current named/global tables for all 337 package families yields 1,111 serialized rows, 736 unique named tags and exactly 281 source-named activity roots: 57 SActivity_ROI map roots and 224 SUnkActivity_ROI scenario roots. Thirteen named rows are legitimate cross-package registrations; registering package and FileHash-encoded physical target are preserved separately. The final inventory has zero violations.",
      "source_ids": ["source:activity_inventory"]
    },
    {
      "id": "assert:scenario_orchestrator",
      "status": "PROVEN",
      "claim": "The generic scenario activity graph orchestrator reproduces the complete moon_raid_1 canary end-to-end with 282 runtime placements, 10 S6E resources, 509 unique F603 resources, 547 F603 stage occurrences, 40 stages, 192 scripted-table owners, 192 D912 tables and 243 scripted records.",
      "source_ids": ["source:scenario_orchestrator_run", "source:scenario_orchestrator_tool"]
    },
    {
      "id": "assert:map_graph_canaries",
      "status": "PROVEN",
      "claim": "One generic remote SActivity_ROI parser closes Tower, Cosmodrome, Venus and Crota's End map roots with zero violations despite substantially different world sizes. It preserves the source-pinned SActivity_ROI -> BubbleDefinition -> MapContainer -> SMapDataTable chain.",
      "source_ids": ["source:map_canary_run", "source:map_graph_tool"]
    },
    {
      "id": "assert:universal_goal",
      "status": "TARGET",
      "claim": "All 281 current named D1 activity roots should ultimately produce complete deterministic exports through reusable schemas and ownership rules, including world geometry, placements, actors, controllers, animations, materials, effects and audio rather than activity-specific code.",
      "source_ids": ["source:activity_inventory", "source:scenario_orchestrator_tool", "source:map_graph_tool"]
    }
